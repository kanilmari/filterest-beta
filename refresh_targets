#!/bin/bash
# ==============================================================================
# refresh_targets: Easelect Targeted Refresh Shortcut
#
# Thin wrapper that calls the main implementation in:
#   server_tools/refresh_targets.sh
#
# Usage:
#   ./refresh_targets --profile easelect-trio
#   ./refresh_targets --target local-native
#   ./refresh_targets --target local-docker:easelect.com
# ==============================================================================

# Prevent sourcing - this script must be executed, not sourced
if [[ "${BASH_SOURCE[0]}" != "${0}" ]]; then
    echo -e "\033[0;31mError: This script must be executed, not sourced.\033[0m"
    echo "Use: ./refresh_targets [options]"
    return 1 2>/dev/null || exit 1
fi

# Get the directory where this script is located (project root)
PROJECT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Resolve environment (PATH, cd to project root) — needed for su/root
source "$PROJECT_ROOT/server_tools/ctl/lib/resolve_env.sh"

# Call the main implementation with all arguments
exec "$PROJECT_ROOT/server_tools/refresh_targets.sh" "$@"
