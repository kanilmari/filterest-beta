#!/bin/bash
# safe_grep: A wrapper to prevent terminal hanging by forcing non-interactive output.
# Usage: ./safe_grep "pattern" [path]

set -euo pipefail

# Get the directory where this script is located (project root)
PROJECT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Resolve environment (PATH, cd to project root) — needed for su/root
source "$PROJECT_ROOT/server_tools/ctl/lib/resolve_env.sh"

if [ -z "${1:-}" ]; then
    echo "Usage: ./safe_grep \"pattern\" [path]"
    exit 1
fi

PATTERN="$1"
PATH_ARG="${2:-.}"

# Check if we are in a git repository
if git rev-parse --is-inside-work-tree > /dev/null 2>&1; then
    # Use git grep
    # --no-pager: Prevent paging
    # -I: Ignore binary files
    # -n: Show line numbers
    git --no-pager grep -I -n "$PATTERN" "$PATH_ARG"
else
    # Fallback to standard grep
    # -r: Recursive
    # -I: Ignore binary files
    # -n: Show line numbers
    grep -rIn "$PATTERN" "$PATH_ARG"
fi
