#!/bin/bash
# ==============================================================================
# api_crud: Easelect CRUD API helper
#
# Thin wrapper that calls server_tools/agent_tools/api_crud.py.
# Uses application HTTP APIs, dev login, and CSRF instead of direct SQL writes.
# ==============================================================================

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/server_tools/ctl/lib/resolve_env.sh"

exec python3 "$PROJECT_ROOT/server_tools/agent_tools/api_crud.py" "$@"
