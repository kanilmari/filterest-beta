#!/usr/bin/env bash
# browser_audit — Run a local browser audit for one URL.
# Bridges Playwright capture, axe accessibility checks, Lighthouse metrics, and Visual Guardian AI review.
# Writes read-only audit artifacts under agent_tasks/_artifacts/browser_audits/.
# Exists so developers can ask one command to navigate, see, measure, and report concrete fixes.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PROJECT_ROOT="$SCRIPT_DIR"

source "$PROJECT_ROOT/server_tools/ctl/lib/resolve_env.sh"

node "$PROJECT_ROOT/server_tools/scripts/browser_audit.mjs" "$@"
