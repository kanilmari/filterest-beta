#!/bin/bash
# ==============================================================================
# dev_status: Inspect the tracked app/DB pair and the current development DB
#
# Thin wrapper that calls:
#   server_tools/agent_tools/dev_status.py
# ==============================================================================

if [[ "${BASH_SOURCE[0]}" != "${0}" ]]; then
    echo -e "\033[0;31mError: This script must be executed, not sourced.\033[0m"
    echo "Use: ./dev_status"
    return 1 2>/dev/null || exit 1
fi

PROJECT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

source "$PROJECT_ROOT/server_tools/ctl/lib/resolve_env.sh"

exec python3 "$PROJECT_ROOT/server_tools/agent_tools/dev_status.py" "$@"
