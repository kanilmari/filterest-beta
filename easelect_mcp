#!/bin/bash
# ==============================================================================
# easelect_mcp: Easelect developer MCP stdio server
#
# Thin wrapper that calls server_tools/agent_tools/easelect_mcp_server.py.
# Exposes selected Easelect developer API actions to MCP clients.
# ==============================================================================

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/server_tools/ctl/lib/resolve_env.sh"

exec python3 "$PROJECT_ROOT/server_tools/agent_tools/easelect_mcp_server.py" "$@"
